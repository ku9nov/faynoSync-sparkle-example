# App config lives in Resources/Info.plist (SUFeedURL, SUPublicEDKey, FaynoSync* keys).
# These variables are consumed by the build/appcast scripts only.
SPARKLE_BIN=./tools
DEVELOPER_ID="Developer ID Application: Your Name (TEAMID)"
DEVELOPMENT_TEAM=TEAMID
# Base for update archives: {feedBase}/sparkle/{owner}/{app}
# release.sh appends {platform}/{arch}/{channel}/ per build.
DOWNLOAD_URL_PREFIX=https://cdn.example.com/sparkle/admin/faynosyncSparkleExample

# Optional appcast enrichment (make appcast). Uncomment to include the field.
# LINK=https://faynosync.example.com
# FULL_RELEASE_NOTES_URL=https://faynosync.example.com/releases
# RELEASE_NOTES_URL_PREFIX=https://cdn.example.com/sparkle/admin/faynosyncSparkleExample/notes/
# CRITICAL_UPDATE_VERSION=2
# PHASED_ROLLOUT_INTERVAL=86400
# INFORMATIONAL_UPDATE_VERSIONS=<1        # needs LINK
# MAJOR_VERSION=1
# IGNORE_SKIPPED_UPGRADES_BELOW_VERSION=1
# MAXIMUM_VERSIONS=3
# MAXIMUM_DELTAS=5
# DELTA_COMPRESSION=lzma                  # lzma|lzfse|lz4|default
# VERSIONS=3                              # comma list of CFBundleVersion
# EMBED_RELEASE_NOTES=1
# SPARKLE_CHANNEL=nightly                 # adds sparkle:channel; clients must opt in
# SPARKLE_ACCOUNT=ed25519                 # keychain key name
# ED_KEY_FILE=                            # CI: private key file, or '-' for stdin
# Injected verbatim into every <item> (generate_appcast cannot emit these):
# MAXIMUM_SYSTEM_VERSION=26.0
# MINIMUM_UPDATE_VERSION=1
# EXTRA_ITEM_XML=<sparkle:hardwareRequirements>...</sparkle:hardwareRequirements>  # raw XML, may be multi-line
